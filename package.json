{
  "name": "eightcore",
  "version": "0.1.0",
  "private": true,
  "description": "Eightcore — the operating system for modern agency operations.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/db/seed.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:studio": "drizzle-kit studio",
    "licenses:check": "node scripts/check-licenses.mjs",
    "secrets:scan": "node scripts/scan-client-bundle.mjs",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run licenses:check && npm test && npm run build && npm run secrets:scan && npm run test:e2e",
    "db:test:create": "tsx scripts/db/create-test-db.ts",
    "db:supabase:setup": "tsx scripts/db/supabase-setup.ts",
    "db:migrate:supabase": "tsx --env-file=.env.supabase-admin scripts/db/migrate.ts",
    "import:clickup": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/import/clickup-csv.ts",
    "import:clickup:supabase": "tsx --env-file=.env.netlify --conditions=react-server --tsconfig tsconfig.json scripts/import/clickup-csv.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "file-type": "22.2.0",
    "fractional-indexing": "4.0.0",
    "geist": "1.7.2",
    "lucide-react": "1.56.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
