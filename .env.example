# Copy to .env.local and fill in. Never commit .env.local.
# Generate secrets with: openssl rand -base64 32

# App role (data access only) and migrator role (DDL). See docker/postgres/.
DATABASE_URL=postgres://eightcore_app:eightcore@localhost:5432/eightcore
DATABASE_MIGRATOR_URL=postgres://eightcore_migrator:eightcore@localhost:5432/eightcore

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email. With SMTP_URL set (Mailpit: smtp://localhost:1025), mail goes over SMTP.
# Without it, outgoing mail is written as JSON files to MAIL_OUTBOX_DIR and the link is logged.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Eightcore <no-reply@eightcore.local>"
# MAIL_OUTBOX_DIR=.mail

# --- Hosted deployments (Netlify + Supabase): see docs/DEPLOY_NETLIFY_SUPABASE.md ---
# PEM text of the database server's CA (Supabase: Project Settings > Database > SSL), or a file path.
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=./prod-ca-2021.crt
# Connections per app instance (serverless: keep small).
# DATABASE_POOL_MAX=3
# Sign-up: "invite-only" (default in production) or "open" (default otherwise).
# SIGNUP_MODE=invite-only
# Emails allowed to sign up without an invitation (comma-separated), e.g. the first owner.
# SIGNUP_ALLOWED_EMAILS=you@yourdomain.com
# Header(s) holding the visitor IP behind the host's proxy. Netlify: x-nf-client-connection-ip
# AUTH_IP_HEADERS=
